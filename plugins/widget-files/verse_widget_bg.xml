<?xml version="1.0" encoding="utf-8"?>
<!--
  Widget background: warm dark gradient (deep navy → indigo) with rounded
  corners that match the visual language of the in-app verse-of-day card.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="#1E1B4B"
        android:centerColor="#3B2566"
        android:endColor="#7C2D12"
        android:type="linear" />
    <corners android:radius="20dp" />
</shape>
