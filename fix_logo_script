from PIL import Image, ImageChops

def center_image(input_path, output_path):
    img = Image.open(input_path).convert("RGBA")
    width, height = img.size
    
    # Use the RGB version to find the bounding box of non-black pixels
    rgb_img = img.convert("RGB")
    bbox = rgb_img.getbbox()
    
    if not bbox:
        # Try with a threshold if the background isn't pure black
        # But (0,0,0) was confirmed.
        print("Could not find content to center using standard bbox")
        return

    left, top, right, bottom = bbox
    content_width = right - left
    content_height = bottom - top
    
    # Calculate current center of bbox
    current_center_x = left + content_width / 2
    current_center_y = top + content_height / 2
    
    # Target center
    target_center_x = width / 2
    target_center_y = height / 2
    
    # Offsets
    dx = int(target_center_x - current_center_x)
    dy = int(target_center_y - current_center_y)
    
    print(f"BBox: {bbox}")
    print( content_width, content_height )
    print(f"Current Center: ({current_center_x}, {current_center_y})")
    print(f"Offset: ({dx}, {dy})")
    
    # Shift image by creating a new black canvas and pasting the original with offset
    new_img = Image.new("RGBA", (width, height), (0, 0, 0, 255))
    
    # We want to paste the original pixels such that their center is at (width/2, height/2)
    # The original top-left was (0,0). The new top-left for pasting should be (dx, dy).
    new_img.paste(img, (dx, dy))
    
    new_img.save(output_path)
    print(f"Saved centered image to {output_path}")

if __name__ == "__main__":
    center_image("assets/eternal-stone-logo-v7.png", "assets/eternal-stone-logo-v7-centered.png")
